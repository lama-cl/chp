            "canonicalText": {
              "type": "string"
            },
            "outerVoidPointer": {
              "type": "boolean"
            },
            "outerPointerKind": {
              "enum": [
                "void-data-pointer",
                "nonvoid-data-pointer",
                "function-pointer",
                "not-pointer",
                "unknown"
              ],
              "description": "AST-derived outer QualType classification. In schema version 2 it is required by the dependency-free validator."
            }
          }
        },
        "hasFinalHistory": {
          "type": "boolean"
        },
        "canonicalHistoryId": {
          "type": [
            "string",
            "null"
          ]
        },
        "historyInstances": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/historyInstance"
          }
        },
        "history": {
          "type": "object"
        },
        "operations": {
          "type": "object"
        },
        "refinementFacts": {
          "type": "object"
        },
        "primaryCategory": {
          "enum": [
            "OpaqueTransportOrViewOnly",
            "MonomorphicActiveSpecialization",
            "ByteOrientedActiveAccess",
            "GuardedActiveReinterpretation",
            "UnguardedMultiTargetActiveReinterpretation",
            "MixedOrProvenanceSensitive",
            "ExternalUnknown"
          ]
        },
        "callbackMediation": {
