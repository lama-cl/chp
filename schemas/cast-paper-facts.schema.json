          "properties": {
            "state": {
              "enum": [
                "None",
                "FormalCallbackParameter",
                "UnresolvedCallback",
                "FieldCallback",
                "ResolvedCallback",
                "ResolvedFieldCallback",
                "GuardedResolvedFieldCallback",
                "Unknown"
              ]
            },
            "flags": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "callback",
                "resolvedTarget",
                "fieldCarrier",
                "guardedSelection"
              ],
              "properties": {
                "callback": {
                  "type": "boolean"
                },
                "resolvedTarget": {
                  "type": "boolean"
                },
                "fieldCarrier": {
                  "type": "boolean"
                },
                "guardedSelection": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "fieldStorage": {
          "$ref": "#/$defs/fieldStorage"
        }
