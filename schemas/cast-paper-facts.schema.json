{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/cast-history/cast-paper-facts.schema.json",
  "title": "Cast History Compact Paper Facts (C6g5f4j)",
  "description": "Per-translation-unit compact paper-facts sidecar for paper aggregation and external-tool alignment. Schema version 9 separates raw API-shape declaration inventory from implementation-level semantic and callback-slot relational eligibility. Versions 1 through 8 remain accepted for legacy validation only.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaName",
    "schemaVersion",
    "tu",
    "coverage",
    "subjects",
    "callbackUseRecords"
  ],
  "properties": {
    "schemaName": {
      "const": "cast-history-tu-paper-facts"
    },
    "schemaVersion": {
      "enum": [
        1,
        2,
        3,
        4,
        5,
        6,
        7,
        8,
        9
      ],
      "description": "Version 9 is current. Versions 1 through 8 are accepted for legacy validation only."
    },
    "toolVersion": {
      "type": "string"
    },
    "tu": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "sourceFile"
      ],
      "properties": {
        "sourceFile": {
          "type": "string"
        },
        "configurationId": {
          "type": "string"
        },
        "compileCommandHash": {
          "type": "string"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "subjectRows",
        "subjectsWithFinalHistory",
        "callbackUseRecords",
        "arrayIndexDirectionModel"
      ],
      "properties": {
        "subjectRows": {
          "type": "integer",
          "minimum": 0
        },
        "subjectsWithFinalHistory": {
          "type": "integer",
          "minimum": 0
        },
        "callbackUseRecords": {
          "type": "integer",
          "minimum": 0
        },
        "arrayIndexDirectionModel": {
          "type": "string"
        },
        "declaredOuterPointerKindModel": {
          "type": "string",
          "description": "Version 2 producer model; clang-qualtype-outer-pointer-kind-v1 for the current implementation."
        },
        "callbackMediationModel": {
          "type": "string",
          "description": "Version 3 producer model; callback-mediation-state-v1 for the current implementation."
        },
        "declaredPointerInventoryModel": {
          "type": "string",
          "description": "Version 4 producer model; project-owned-local-parameter-direct-pointer-v1."
        },
        "declaredPointerInventoryScope": {
          "enum": [
            "project-root-v1",
            "main-tu-fallback-v1"
          ]
        },
        "declaredPointerInventoryScopeComplete": {
          "type": "boolean"
        },
        "declaredPointerInventoryRows": {
          "type": "integer",
          "minimum": 0
        },
        "declaredEligibleDataPointerRows": {
          "type": "integer",
          "minimum": 0
        },
        "declaredEligibleVoidPointerRows": {
          "type": "integer",
          "minimum": 0
        },
        "declaredEligibleVoidPointerSubjectFacts": {
          "type": "integer",
          "minimum": 0
        },
        "declaredEligibleVoidPointerFinalHistory": {
          "type": "integer",
          "minimum": 0
        },
        "declaredEligibleVoidPointerClassified": {
          "type": "integer",
          "minimum": 0
        },
        "declaredEligibleVoidPointerNoObservedFacts": {
          "type": "integer",
          "minimum": 0
        },
        "finalHistoryWithoutSubjectRow": {
          "type": "integer",
          "minimum": 0
        },
        "fieldStorageClassificationModel": {
          "type": "string",
          "description": "Version 5 producer model; resolved-instance-field-storage-v1."
        },
        "observedNoFinalHistoryPatternModel": {
          "type": "string",
          "description": "Version 7 producer model; retained-pointer-use-and-syntactic-usage-v1."
        },
        "allocationOriginDerivedAliasUses": {
          "type": "integer",
          "minimum": 0,
          "description": "Version 8 producer count of recognized allocator-origin / typed-derived-alias-use rows."
        },
        "allocationOriginDerivedAliasModel": {
          "type": "string",
          "description": "Version 8 producer model; recognized-allocator-origin-and-may-derived-alias-use-v1."
        },
        "declaredDirectVoidPointerInventoryRows": {
          "type": "integer",
          "minimum": 0,
          "description": "Version 9 raw direct outer void-pointer local/parameter inventory count, including unavailable API declarations."
        },
        "declaredExcludedUnavailableApiVoidPointerRows": {
          "type": "integer",
          "minimum": 0,
          "description": "Version 9 direct void-pointer parameters retained as API shape but excluded because no project-owned owner-function body is available."
        },
        "eligibleNestedCallbackSlotRelations": {
          "type": "integer",
          "minimum": 0,
          "description": "Version 9 nested callback slots eligible for relational analysis."
        },
        "excludedUnavailableApiNestedCallbackSlots": {
          "type": "integer",
          "minimum": 0,
          "description": "Version 9 nested callback slots retained as prototype API shape but excluded because the owner function body is unavailable."
        }
      }
    },
    "subjects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/subject"
      }
    },
    "callbackUseRecords": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/callbackUse"
      }
    },
    "declaredPointerInventory": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/declaredPointerInventoryEntry"
      }
    },
    "nestedCallbackSlotRelations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nestedCallbackSlotRelation"
      }
    },
    "voidPointerUsageFingerprints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/voidPointerUsageFingerprint"
      }
    },
    "allocationOriginDerivedAliasUses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/allocationOriginDerivedAliasUse"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 2
          }
        },
        "required": [
          "schemaVersion"
        ]
      },
      "then": {
        "properties": {
          "coverage": {
            "required": [
              "declaredOuterPointerKindModel"
            ]
          },
          "subjects": {
            "items": {
              "properties": {
                "declaredType": {
                  "required": [
                    "outerPointerKind"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 3
          }
        },
        "required": [
          "schemaVersion"
        ]
      },
      "then": {
        "properties": {
          "coverage": {
            "required": [
              "declaredOuterPointerKindModel",
              "callbackMediationModel"
            ]
          },
          "subjects": {
            "items": {
              "required": [
                "callbackMediation"
              ],
              "properties": {
                "declaredType": {
                  "required": [
                    "outerPointerKind"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 4
          }
        },
        "required": [
          "schemaVersion"
        ]
      },
      "then": {
        "required": [
          "declaredPointerInventory"
        ],
        "properties": {
          "coverage": {
            "required": [
              "declaredOuterPointerKindModel",
              "callbackMediationModel",
              "declaredPointerInventoryModel",
              "declaredPointerInventoryScope",
              "declaredPointerInventoryScopeComplete",
              "declaredPointerInventoryRows",
              "declaredEligibleDataPointerRows",
              "declaredEligibleVoidPointerRows",
              "declaredEligibleVoidPointerSubjectFacts",
              "declaredEligibleVoidPointerFinalHistory",
              "declaredEligibleVoidPointerClassified",
              "declaredEligibleVoidPointerNoObservedFacts",
              "finalHistoryWithoutSubjectRow"
            ]
          },
          "subjects": {
            "items": {
              "required": [
                "callbackMediation"
              ],
              "properties": {
                "declaredType": {
                  "required": [
                    "outerPointerKind"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 5
          }
        },
        "required": [
          "schemaVersion"
        ]
      },
      "then": {
        "required": [
          "declaredPointerInventory"
        ],
        "properties": {
          "coverage": {
            "required": [
              "declaredOuterPointerKindModel",
              "callbackMediationModel",
              "fieldStorageClassificationModel",
              "declaredPointerInventoryModel",
              "declaredPointerInventoryScope",
              "declaredPointerInventoryScopeComplete",
              "declaredPointerInventoryRows",
              "declaredEligibleDataPointerRows",
              "declaredEligibleVoidPointerRows",
              "declaredEligibleVoidPointerSubjectFacts",
              "declaredEligibleVoidPointerFinalHistory",
              "declaredEligibleVoidPointerClassified",
              "declaredEligibleVoidPointerNoObservedFacts",
              "finalHistoryWithoutSubjectRow"
            ]
          },
          "subjects": {
            "items": {
              "required": [
                "callbackMediation"
              ],
              "properties": {
                "declaredType": {
                  "required": [
                    "outerPointerKind"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 7
          }
        },
        "required": [
          "schemaVersion"
        ]
      },
      "then": {
        "required": [
          "declaredPointerInventory",
          "nestedCallbackSlotRelations",
          "voidPointerUsageFingerprints"
        ],
        "properties": {
          "coverage": {
            "required": [
              "declaredOuterPointerKindModel",
              "callbackMediationModel",
              "fieldStorageClassificationModel",
              "declaredPointerInventoryModel",
              "declaredPointerInventoryScope",
              "declaredPointerInventoryScopeComplete",
              "declaredPointerInventoryRows",
              "declaredEligibleDataPointerRows",
              "declaredEligibleVoidPointerRows",
              "declaredEligibleVoidPointerSubjectFacts",
              "declaredEligibleVoidPointerFinalHistory",
              "declaredEligibleVoidPointerClassified",
              "declaredEligibleVoidPointerNoObservedFacts",
              "finalHistoryWithoutSubjectRow",
              "nestedCallbackSlotRelations",
              "voidPointerUsageFingerprints",
              "nestedCallbackSlotRelationModel",
              "voidPointerUsageFingerprintModel",
              "observedNoFinalHistoryPatternModel"
            ]
          },
          "voidPointerUsageFingerprints": {
            "items": {
              "required": [
                "observedNoFinalHistory"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 8
          }
        },
        "required": [
          "schemaVersion"
        ]
      },
      "then": {
        "required": [
          "declaredPointerInventory",
          "nestedCallbackSlotRelations",
          "voidPointerUsageFingerprints",
          "allocationOriginDerivedAliasUses"
        ],
        "properties": {
          "coverage": {
            "required": [
              "declaredOuterPointerKindModel",
              "callbackMediationModel",
              "fieldStorageClassificationModel",
              "declaredPointerInventoryModel",
              "declaredPointerInventoryScope",
              "declaredPointerInventoryScopeComplete",
              "declaredPointerInventoryRows",
              "declaredEligibleDataPointerRows",
              "declaredEligibleVoidPointerRows",
              "declaredEligibleVoidPointerSubjectFacts",
              "declaredEligibleVoidPointerFinalHistory",
              "declaredEligibleVoidPointerClassified",
              "declaredEligibleVoidPointerNoObservedFacts",
              "finalHistoryWithoutSubjectRow",
              "nestedCallbackSlotRelations",
              "voidPointerUsageFingerprints",
              "nestedCallbackSlotRelationModel",
              "voidPointerUsageFingerprintModel",
              "observedNoFinalHistoryPatternModel",
              "allocationOriginDerivedAliasUses",
              "allocationOriginDerivedAliasModel"
            ]
          },
          "voidPointerUsageFingerprints": {
            "items": {
              "required": [
                "observedNoFinalHistory"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 9
          }
        },
        "required": [
          "schemaVersion"
        ]
      },
      "then": {
        "required": [
          "declaredPointerInventory",
          "nestedCallbackSlotRelations",
          "voidPointerUsageFingerprints",
          "allocationOriginDerivedAliasUses"
        ],
        "properties": {
          "coverage": {
            "required": [
              "declaredOuterPointerKindModel",
              "callbackMediationModel",
              "fieldStorageClassificationModel",
              "declaredPointerInventoryModel",
              "declaredPointerInventoryScope",
              "declaredPointerInventoryScopeComplete",
              "declaredPointerInventoryRows",
              "declaredEligibleDataPointerRows",
              "declaredEligibleVoidPointerRows",
              "declaredEligibleVoidPointerSubjectFacts",
              "declaredEligibleVoidPointerFinalHistory",
              "declaredEligibleVoidPointerClassified",
              "declaredEligibleVoidPointerNoObservedFacts",
              "finalHistoryWithoutSubjectRow",
              "nestedCallbackSlotRelations",
              "voidPointerUsageFingerprints",
              "nestedCallbackSlotRelationModel",
              "voidPointerUsageFingerprintModel",
              "observedNoFinalHistoryPatternModel",
              "allocationOriginDerivedAliasUses",
              "allocationOriginDerivedAliasModel",
              "declaredDirectVoidPointerInventoryRows",
              "declaredExcludedUnavailableApiVoidPointerRows",
              "eligibleNestedCallbackSlotRelations",
              "excludedUnavailableApiNestedCallbackSlots"
            ]
          },
          "voidPointerUsageFingerprints": {
            "items": {
              "required": [
                "observedNoFinalHistory"
              ]
            }
          },
          "declaredPointerInventory": {
            "items": {
              "required": [
                "semanticClassificationScope",
                "ownerDefinitionAvailable",
                "eligibilityExclusionReason"
              ]
            }
          },
          "nestedCallbackSlotRelations": {
            "items": {
              "required": [
                "eligibleForRelationalClassification",
                "ownerDefinitionAvailable",
                "relationalClassificationScope",
                "eligibilityExclusionReason"
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
