    "subject": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "subjectId",
        "rootSubjectId",
        "entity",
        "subjectKind",
        "location",
        "function",
        "declaredType",
        "hasFinalHistory",
        "historyInstances",
        "history",
        "operations",
        "refinementFacts",
        "primaryCategory"
      ],
      "properties": {
        "subjectId": {
          "type": "string",
          "minLength": 1
        },
        "rootSubjectId": {
          "type": "string",
          "minLength": 1
        },
        "entity": {
          "type": "string"
        },
        "subjectKind": {
          "enum": [
            "global",
            "local",
            "parameter",
            "field",
            "field-storage",
            "return",
            "value",
            "unknown"
          ]
        },
        "location": {
          "$ref": "#/$defs/source"
        },
        "function": {
          "type": "object"
        },
        "declaredType": {
          "type": "object",
          "additionalProperties": true,
          "required": [
