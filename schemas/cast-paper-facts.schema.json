          "type": "string",
          "minLength": 1
        },
        "subjectId": {
          "type": "string",
          "minLength": 1
        },
        "callSite": {
          "$ref": "#/$defs/source"
        },
        "targetFunctions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "operationKind": {
          "type": "string"
        },
        "activeOperation": {
          "type": "boolean"
        },
        "flags": {
          "type": "object"
        }
      }
    },
    "declaredPointerInventoryEntry": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "declarationId",
        "subjectId",
        "subjectKind",
        "location",
        "function",
        "declaredType",
