      "properties": {
        "declarationId": {
          "type": "string",
          "minLength": 1
        },
        "subjectId": {
          "type": "string",
          "minLength": 1
        },
        "subjectKind": {
          "enum": [
            "local",
            "parameter"
          ]
        },
        "location": {
          "$ref": "#/$defs/source"
        },
        "function": {
          "type": "object"
