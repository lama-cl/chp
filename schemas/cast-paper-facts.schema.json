      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 0
        },
        "column": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "historyInstance": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "historyId",
        "view",
        "hasFinalHistory",
        "metrics"
      ],
      "properties": {
        "historyId": {
          "type": "string",
          "minLength": 1
        },
        "view": {
          "enum": [
            "direct",
            "storage"
          ]
        },
        "hasFinalHistory": {
          "type": "boolean"
        },
        "metrics": {
          "type": "object"
        }
      }
